{
  "name": "bangumi-manager",
  "version": "0.1.1",
  "private": true,
  "description": "简洁的 Bangumi 番剧管理桌面端",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "vite preview",
    "dist": "npm run build && node scripts/pack-green.mjs",
    "dist:nsis": "npm run build && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-store": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "local.bangumi.manager",
    "productName": "番剧管理",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "protocols": [
      {
        "name": "Bangumi Manager Watched",
        "schemes": ["bgmtv-helper"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
